# Comma-separated exact origins. Vercel preview deployments (*.vercel.app) are also allowed.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# OpenAI-powered vector embeddings and grounded policy assessment. Keep server-side only.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Set true to refresh the indexed corpus by fetching the linked official source documents/pages.
POLICY_REFRESH_SOURCES=false
# Leave blank to use the in-process local demo adapter; set the standalone portal URL for REST integration.
MOCK_PORTAL_URL=
# Set to 503 on the portal service to simulate maintenance and exercise retries.
MOCK_PORTAL_FAIL_STATUS=
