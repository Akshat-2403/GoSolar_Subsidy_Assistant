# Add exact custom frontend origins as comma-separated values. *.vercel.app previews are allowed.
CORS_ORIGINS=
# Optional free-tier Gemini chat. Leave blank for entirely offline/no-API operation.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Optional server-side mock portal service address. Browser clients use /api/mock-discom/portal.
MOCK_PORTAL_URL=
# Set to 503 on the portal service to simulate maintenance and exercise retries.
MOCK_PORTAL_FAIL_STATUS=
# SQLite path for saved demo application tracking records. Use a mounted data volume in production.
GOSOLAR_DATABASE_PATH=./data/gosolar.sqlite3
# Optional OCR worker is not required; the frontend falls back to sample bill metadata when unavailable.
