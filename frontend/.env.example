# Optional for a separately hosted API. Leave blank to use same-origin /api routes.
VITE_API_BASE_URL=
# Vite development proxy target, defaults to http://127.0.0.1:8000.
VITE_BACKEND_URL=
# Optional absolute external portal override. Leave blank to use the client-side preview (works without a backend).
VITE_PORTAL_URL=
# Optional OCR worker endpoint. Defaults to /api/bills/parse and uses sample extraction when unavailable.
VITE_BILL_OCR_URL=
